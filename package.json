{
  "name": "brew-me-app-lit",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test --workers 8",
    "screenshots": "node scripts/capture-screenshots.js"
  },
  "dependencies": {
    "@lit-labs/preact-signals": "^1.0.3",
    "@lit-labs/router": "^0.1.4",
    "idb": "^8.0.3",
    "lit": "^3.3.3",
    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitest/coverage-v8": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
